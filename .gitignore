# Local, untracked context
*.local.md

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem

# OS and editor
.DS_Store
.idea/
.vscode/

# Build outputs
bin/
/dist/
/build/
# A plain `go build` inside cmd/oarfish-update-helper writes the program next to
# its sources; the Makefile and scripts/build-helper.sh write to bin/.
/backend/cmd/oarfish-update-helper/oarfish-update-helper
/backend/cmd/oarfish-update-helper/oarfish-update-helper.exe
/backend/cmd/oarfish-update-helper/*.test

# State of the development backend (make dev): account, setup token, audit
/.dev-state/
frontend/dist/
coverage/
node_modules/
frontend/.svelte-kit/
frontend/build/

# Frontend production build lands in the Go embed directory; only the
# placeholder is tracked so `go build` works on a fresh checkout.
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Logs
*.log
