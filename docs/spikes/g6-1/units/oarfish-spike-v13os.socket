# G6.1 spike, throwaway (V13, exploration): socket text of ADR 0010, U10, with the spike path.
[Unit]
Description=Oarfish G6.1 spike: socket that its own service restarts (V13, exploration)

[Socket]
ListenStream=/run/oarfish-spike-update/v13os.sock
SocketUser=root
SocketGroup=oarfish
SocketMode=0660
DirectoryMode=0755
Accept=no
Backlog=8
RemoveOnStop=yes
